# LLM - gemini(기본) | ollama (임베딩은 항상 Gemini 사용)
LLM_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Ollama (LLM_PROVIDER=ollama일 때만 사용, 로컬 개발용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# DB - 임베딩 저장용 (scripts/embed.ts에서 사용)
EMBED_DATABASE_URL=postgresql://embed_user:***@ep-shy-band-b32zmbau-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# DB - 챗봇 검색용 (Next.js API Route에서 사용)
DATABASE_URL=postgresql://readonly_user:***@ep-shy-band-b32zmbau-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# DB - 대화 체크포인트 저장용 (langgraph 스키마만 쓰기 가능, Next.js API Route·scripts/setup-checkpointer.ts에서 사용)
CHECKPOINT_DATABASE_URL=postgresql://checkpoint_user:***@ep-shy-band-b32zmbau-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
